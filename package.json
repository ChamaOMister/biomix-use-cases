{
  "name": "biomix-erp-sales-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:data": "node scripts/generate-synthetic-data.ts",
    "setup:env": "node scripts/setup-dev-env.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:reset": "node scripts/db-reset.ts",
    "feed:send": "node scripts/send-deliveries.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jszip": "3.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
