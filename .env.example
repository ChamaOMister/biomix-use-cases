# Copy what you need to .env.local (Git-ignored). The dev container sets DATABASE_URL itself and
# `npm run setup:env` writes a random SALES_FEED_API_KEY to .env.local.
NEXT_TELEMETRY_DISABLED=1
# Postgres connection for the app, scripts and database tests (dev container value shown).
DATABASE_URL=postgres://biomix:biomix@localhost:5432/biomix
# Development-only key the sales-feed endpoint requires in the X-Api-Key header. Choose your own.
SALES_FEED_API_KEY=
